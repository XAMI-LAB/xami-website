{
  "name": "xami-website",
  "compatibility_date": "2026-09-27",
  // The site is reached at www.xami-lab.org only, so both workers.dev addresses are off: the Worker's
  // Domains tab shows them as two switches, Production ("workers_dev") and Preview ("preview_urls").
  // Both are written here so that neither depends on a default; without "workers_dev" a deploy turns
  // Production back on. Branch previews are served from the lab's own preview domain
  // (<branch>.preview.xami-lab.org), which is attached to the Worker in the dashboard.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // the pages, as built by "pnpm build"
    "directory": "./build/client",
    // An unknown address gets build/client/404.html. Branch previews answer with a bare "Not found" instead;
    // that is how Cloudflare's previews behave, not a fault in the site.
    "not_found_handling": "404-page",
  },
  // Branch Previews (built by "wrangler preview" on non-production branches)
  "previews": {},
}
